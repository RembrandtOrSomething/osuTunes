<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permission to read external storage -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    
    <!-- Permission for wakelock to keep device awake during playback -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- needed when starting a foreground service on API 28+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- needed for media playback foreground service on API 34+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:allowBackup="true"
        android:label="osu!tunes"
        android:icon="@drawable/ic_music_note"
        android:roundIcon="@drawable/ic_music_note"
        android:supportsRtl="true"
        android:theme="@style/Theme.OsuTunes.Dark">
        
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- service keeps a strong wakelock during playback and handles task removal -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
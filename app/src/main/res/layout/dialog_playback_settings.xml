<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Shuffle Mode"
                android:textSize="16sp"
                android:textColor="@android:color/white"/>

            <Switch
                android:id="@+id/switchShuffle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="#A6E3A1"
                android:trackTint="#6C7086"/>
        </LinearLayout>
        
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#45475A"
            android:layout_marginVertical="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Loop (Repeat Song)"
                android:textSize="16sp"
                android:textColor="@android:color/white"/>

            <Switch
                android:id="@+id/switchLoop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="#89B4FA"
                android:trackTint="#6C7086"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#45475A"
            android:layout_marginVertical="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Playback Speed (0.5x to 1.5x)"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <SeekBar
                android:id="@+id/seekBarSpeed"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:max="200"
                android:progress="100" 
                android:progressTint="#F9E2AF"
                android:thumbTint="#F9E2AF"/>

            <TextView
                android:id="@+id/textSpeedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="50dp"
                android:gravity="end"
                android:text="1.00x"
                android:textColor="#F9E2AF"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#45475A"
            android:layout_marginVertical="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Playback Pitch (0.5x to 1.5x)"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <SeekBar
                android:id="@+id/seekBarPitch"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:max="200"
                android:progress="100" 
                android:progressTint="#F38BA8"
                android:thumbTint="#F38BA8"/>

            <TextView
                android:id="@+id/textPitchValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="50dp"
                android:gravity="end"
                android:text="1.00x"
                android:textColor="#F38BA8"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
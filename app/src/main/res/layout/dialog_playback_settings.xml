<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="#1E1E2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Tempo -->
        <TextView
            android:id="@+id/dialogTempoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tempo"
            android:textColor="#BAC2DE"
            android:textSize="14sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <SeekBar
                android:id="@+id/dialogTempoSeekBar"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:max="400"
                android:progress="100"
                android:progressTint="#CBA6F7"
                android:thumbTint="#CBA6F7"/>

            <Button
                android:id="@+id/dialogResetTempoButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset"
                android:textSize="12sp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#CBA6F7"/>
        </LinearLayout>

        <TextView
            android:id="@+id/dialogTempoTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.00x"
            android:textColor="#CBA6F7"
            android:layout_marginTop="4dp"/>

        <!-- Pitch -->
        <TextView
            android:id="@+id/dialogPitchLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pitch"
            android:textColor="#BAC2DE"
            android:textSize="14sp"
            android:layout_marginTop="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <SeekBar
                android:id="@+id/dialogPitchSeekBar"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:max="400"
                android:progress="100"
                android:progressTint="#F38BA8"
                android:thumbTint="#F38BA8"/>

            <Button
                android:id="@+id/dialogResetPitchButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset"
                android:textSize="12sp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#F38BA8"/>
        </LinearLayout>

        <TextView
            android:id="@+id/dialogPitchTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.00x"
            android:textColor="#F38BA8"
            android:layout_marginTop="4dp"/>

        <!-- Shuffle & Loop -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/dialogShuffleButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Shuffle: Off"
                android:backgroundTint="#89B4FA"/>

            <Button
                android:id="@+id/dialogRepeatButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Loop: Off"
                android:backgroundTint="#F38BA8"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>